[{"updatedAt":"2026-09-25T17:33:49.090Z","createdAt":"2026-09-24T15:13:15.497Z","id":"7bZ9MTTdzcfrzjrk","name":"伺服器健康度與硬碟預警器 (Server Sentinel)","description":null,"active":true,"isArchived":false,"nodes":[{"parameters":{"chatId":"6188487604","text":"=🚨 <b>【Ubuntu 伺服器異常告警】</b>\n──────────────────\n💾 <b>硬碟使用率</b>：<code>{{ $json.diskUsage }}%</code>\n🧠 <b>記憶體使用率</b>：<code>{{ $json.memUsage }}%</code>\n⚡ <b>CPU 負載</b>：<code>{{ $json.cpuUsage }}%</code>\n⏰ <b>發生時間</b>：<code>{{ $json.timestamp }}</code>\n──────────────────\n💡 <i>伺服器資源達到警戒門檻，請登入 Portainer 查看！</i>","additionalFields":{"appendAttribution":false,"parse_mode":"HTML"}},"type":"n8n-nodes-base.telegram","typeVersion":1.2,"position":[-864,544],"id":"8a6af395-a16f-43fe-897f-cac37590b13f","name":"Send a text message","webhookId":"a9b334a6-3967-4407-99aa-7e2e1b127b80","credentials":{"telegramApi":{"id":"cdld53l0U91kawdt","name":"Telegram account"}}},{"parameters":{"jsCode":"const fs = require('fs');\n\n// 讀取 Docker 容器內掛載的 JSON 檔案\nconst rawData = fs.readFileSync('/data/server_status.json', 'utf8');\nconst metrics = JSON.parse(rawData);\n\n// 設定警戒門檻 (硬碟 >= 85%、記憶體 >= 90%、CPU >= 90%)\nconst isAlert = (metrics.diskUsage >= 85 || metrics.memUsage >= 90 || metrics.cpuUsage >= 90);\n\nreturn {\n  json: {\n    diskUsage: metrics.diskUsage,\n    memUsage: metrics.memUsage,\n    cpuUsage: metrics.cpuUsage,\n    isAlert: isAlert,\n    timestamp: metrics.timestamp\n  }\n};"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[-1312,544],"id":"b055f1f6-215f-457f-a737-25855eedaa43","name":"Check Health Metrics"},{"parameters":{"rule":{"interval":[{"field":"minutes","minutesInterval":15}]}},"type":"n8n-nodes-base.scheduleTrigger","typeVersion":1.2,"position":[-1568,544],"id":"61f93177-d2de-47d8-9f62-25c4f3c77a6f","name":"Schedule Trigger1"},{"parameters":{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict","version":2},"conditions":[{"id":"check-alert","leftValue":"={{ $json.isAlert }}","rightValue":true,"operator":{"type":"boolean","operation":"true"}}],"combinator":"and"},"options":{}},"type":"n8n-nodes-base.if","typeVersion":2.2,"position":[-1072,544],"id":"06d63ceb-0348-4ac6-9f6b-c4797400a0a4","name":"If Threshold Exceeded1"}],"connections":{"Check Health Metrics":{"main":[[{"node":"If Threshold Exceeded1","type":"main","index":0}]]},"Schedule Trigger1":{"main":[[{"node":"Check Health Metrics","type":"main","index":0}]]},"If Threshold Exceeded1":{"main":[[{"node":"Send a text message","type":"main","index":0}]]}},"settings":{"executionOrder":"v1","binaryMode":"separate","availableInMCP":true},"staticData":{"node:Schedule Trigger1":{"recurrenceRules":[null],"recurrenceRuleSignatures":[null]}},"meta":{"templateCredsSetupCompleted":true},"nodeGroups":[],"pinData":{},"versionId":"5602d5b2-303f-4e61-8f63-5f6eb30ab839","activeVersionId":"5602d5b2-303f-4e61-8f63-5f6eb30ab839","versionCounter":41,"triggerCount":1,"sourceWorkflowId":null,"tags":[],"shared":[{"updatedAt":"2026-09-24T15:13:15.507Z","createdAt":"2026-09-24T15:13:15.507Z","role":"workflow:owner","workflowId":"7bZ9MTTdzcfrzjrk","projectId":"2GE0NpKyz38mzQjD","project":{"updatedAt":"2026-09-22T10:08:10.916Z","createdAt":"2026-09-22T10:06:01.902Z","id":"2GE0NpKyz38mzQjD","name":"丞言 張 <zhangchengyan0305@gmail.com>","type":"personal","icon":null,"description":null,"customTelemetryTags":[],"creatorId":"edc81569-ba03-4719-8074-a3b61e2d6cbd"}}],"versionMetadata":{"name":"Version 5602d5b2","description":""}}]