[{"updatedAt":"2026-09-24T15:38:28.927Z","createdAt":"2026-09-24T05:41:45.787Z","id":"sUTcL357cQ9nAamR","name":"量化交易學習小卡","description":null,"active":true,"isArchived":false,"nodes":[{"parameters":{"rule":{"interval":[{"triggerAtHour":12}]}},"type":"n8n-nodes-base.scheduleTrigger","typeVersion":1.4,"position":[-976,112],"id":"fc1db39a-bb60-4372-9a98-fcdaaca36fff","name":"Schedule Trigger"},{"parameters":{"authentication":"serviceAccount","documentId":{"__rl":true,"value":"14Mr6z9YBGAOoObo6aQaY3cE30nqSQ7-yLAKCRxJVCgw","mode":"list","cachedResultName":"Quant_Learning_Plan","cachedResultUrl":"https://docs.google.com/spreadsheets/d/14Mr6z9YBGAOoObo6aQaY3cE30nqSQ7-yLAKCRxJVCgw/edit?usp=drivesdk"},"sheetName":{"__rl":true,"value":"gid=0","mode":"list","cachedResultName":"Sheet1","cachedResultUrl":"https://docs.google.com/spreadsheets/d/14Mr6z9YBGAOoObo6aQaY3cE30nqSQ7-yLAKCRxJVCgw/edit#gid=0"},"filtersUI":{"values":[{"lookupColumn":"狀態 (Status)","lookupValue":"Pending"}]},"options":{"returnFirstMatch":true}},"type":"n8n-nodes-base.googleSheets","typeVersion":4.7,"position":[-832,112],"id":"bb7eab7b-ebce-417b-bfde-111f8257632d","name":"Get row(s) in sheet","credentials":{"googleApi":{"id":"Hdu86aGYPP3Nkq40","name":"Google Service Account account"}}},{"parameters":{"fromEmail":"zhangchengyan0305@gmail.com","toEmail":"zhangchengyan0305@gmail.com","subject":"=📚 每日量化學習卡片：{{ $('Get row(s) in sheet').item.json[\"學習主題 (Topic)\"] }}","html":"={{ $json.content.parts[0].text }}","options":{"appendAttribution":false}},"type":"n8n-nodes-base.emailSend","typeVersion":2.1,"position":[-480,112],"id":"723b8927-495a-4d1f-9ee3-c411863e7d38","name":"Send an Email","webhookId":"2c935ade-68db-4fb6-b8af-ff4c681b95af","credentials":{"smtp":{"id":"VbOMj6AZ8In00Gok","name":"SMTP account"}}},{"parameters":{"modelId":{"__rl":true,"value":"models/gemini-2.5-flash","mode":"list","cachedResultName":"models/gemini-2.5-flash"},"messages":{"values":[{"content":"你是一位充滿熱情、極度貼心的「白話量化財經導師」。你的教學對象是「完全沒有金融背景的零基礎初學者」。\n\n你的教學核心原則如下：\n1. 嚴禁直接使用未解釋的專業術語（例如 EPS、靜態/動態本益比等）。只要出現任何英文縮寫或專業名詞，必須先用「日常生活中的事物（如買麵包、開店、買房子）」做白話比喻。\n2. 語氣溫暖、鼓勵、結構清晰。\n3. 極度重視排版視覺！善用 Emoji、條列點（-）、適度粗體，並使用清晰的分隔線（───），絕對不能讓文章變成密密麻麻的文字牆。"},{"content":"=請為我製作今天的「量化交易學習卡片」。\n\n今日主題：{{ $json[\"學習主題 (Topic)\"] }}\n主題類別：{{ $json[\"階段類別 (Category)\"] }}\n學習重點：{{ $json[\"核心學習重點與量化觀念 (Focus)\"] }}\n\n請不要輸出 Markdown 語法（不要用 #、* 或 >），請嚴格直接輸出以下【HTML 格式】：\n\n<div style=\"font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; max-width: 600px; margin: 0 auto; padding: 20px; color: #ffffff; background-color: #121212; line-height: 1.6;\">\n\n  <h2 style=\"color: #4da6ff; border-bottom: 2px solid #4da6ff; padding-bottom: 8px; margin-top: 0;\">📚 每日量化學習卡片：{{ $json[\"學習主題 (Topic)\"] }}</h2>\n\n  <!-- 核心概念卡片 -->\n  <div style=\"background: #1e1e1e; border-left: 4px solid #00e676; padding: 15px; border-radius: 6px; margin: 20px 0;\">\n    <h3 style=\"color: #00e676; margin-top: 0; font-size: 16px;\">💡 一秒搞懂核心概念（白話版）</h3>\n    <p style=\"margin: 0; font-size: 15px; color: #e0e0e0;\">[請用 1-2 句超級白話文 + 生活比喻（如開手搖飲店）解釋這個主題]</p>\n  </div>\n\n  <!-- 新手字典 -->\n  <div style=\"background: #1e1e1e; padding: 15px; border-radius: 6px; margin: 20px 0;\">\n    <h3 style=\"color: #ffb74d; margin-top: 0; font-size: 16px;\">📖 關鍵名詞大解密（新手小辭典）</h3>\n    <ul style=\"padding-left: 20px; margin: 0; color: #d1d5db;\">\n      <li style=\"margin-bottom: 8px;\"><strong style=\"color: #fff;\">[名詞1，如 P/E Ratio]：</strong> [白話解釋]</li>\n      <li style=\"margin-bottom: 8px;\"><strong style=\"color: #fff;\">[名詞2，如 EPS]：</strong> [白話解釋]</li>\n      <li style=\"margin-bottom: 8px;\"><strong style=\"color: #fff;\">[名詞3，如 靜態 vs 動態]：</strong> [白話解釋]</li>\n    </ul>\n  </div>\n\n  <!-- 公式與邏輯 -->\n  <div style=\"background: #1e1e1e; padding: 15px; border-radius: 6px; margin: 20px 0;\">\n    <h3 style=\"color: #4da6ff; margin-top: 0; font-size: 16px;\">🔢 數學公式與邏輯拆解</h3>\n    <div style=\"background: #2a2a2a; padding: 10px; border-radius: 4px; font-family: monospace; color: #76ff03; text-align: center; font-size: 16px; margin: 10px 0;\">\n      [公式名稱] = [分子] / [分母]\n    </div>\n    <p style=\"margin: 5px 0 0 0; color: #b0bec5; font-size: 14px;\">💡 算式翻譯：這條公式其實就是在問：「[白話問題]？」</p>\n  </div>\n\n  <!-- 量化應用 -->\n  <div style=\"background: #1e1e1e; padding: 15px; border-radius: 6px; margin: 20px 0;\">\n    <h3 style=\"color: #b388ff; margin-top: 0; font-size: 16px;\">🤖 在【量化交易】中怎麼用？</h3>\n    <p style=\"margin: 5px 0; color: #e0e0e0;\">🎯 <strong>[應用一]：</strong> [說明]</p>\n    <p style=\"margin: 5px 0; color: #e0e0e0;\">🎯 <strong>[應用二]：</strong> [說明]</p>\n  </div>\n\n  <!-- 思考題 -->\n  <div style=\"background: #263238; border: 1px dashed #78909c; padding: 15px; border-radius: 6px; margin: 20px 0;\">\n    <h3 style=\"color: #80deea; margin-top: 0; font-size: 16px;\">🧠 今日小思考</h3>\n    <p style=\"margin: 0; color: #eceff1;\">❓ [給初學者的簡單思考題]</p>\n    <p style=\"margin: 8px 0 0 0; color: #b0bec5; font-size: 13px;\">💡 提示：[簡短提示]</p>\n  </div>\n\n</div>"}]},"builtInTools":{"googleSearch":true},"options":{}},"type":"@n8n/n8n-nodes-langchain.googleGemini","typeVersion":1.2,"position":[-720,112],"id":"b44e6163-04a8-4d13-9f45-97cff34e2dd8","name":"Message a model","retryOnFail":true,"maxTries":5,"waitBetweenTries":5000,"credentials":{"googlePalmApi":{"id":"AD3Ze5WtmqnXOZvY","name":"Google Gemini(PaLM) Api account"}}},{"parameters":{"authentication":"serviceAccount","operation":"update","documentId":{"__rl":true,"value":"14Mr6z9YBGAOoObo6aQaY3cE30nqSQ7-yLAKCRxJVCgw","mode":"list","cachedResultName":"Quant_Learning_Plan","cachedResultUrl":"https://docs.google.com/spreadsheets/d/14Mr6z9YBGAOoObo6aQaY3cE30nqSQ7-yLAKCRxJVCgw/edit?usp=drivesdk"},"sheetName":{"__rl":true,"value":"gid=0","mode":"list","cachedResultName":"Sheet1","cachedResultUrl":"https://docs.google.com/spreadsheets/d/14Mr6z9YBGAOoObo6aQaY3cE30nqSQ7-yLAKCRxJVCgw/edit#gid=0"},"columns":{"mappingMode":"defineBelow","value":{"row_number":"={{ $('Get row(s) in sheet').item.json.r